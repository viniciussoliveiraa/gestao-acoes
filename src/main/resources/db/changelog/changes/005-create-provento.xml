<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="005-create-provento-postgres" author="gestao-acoes" context="postgres-h2">
        <createTable tableName="provento">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="usuario_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="acao_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="tipo" type="VARCHAR(15)">
                <constraints nullable="false"/>
            </column>
            <column name="valor_total" type="NUMERIC(19,4)">
                <constraints nullable="false"/>
            </column>
            <column name="data_pagamento" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="criado_em" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <rollback>
            <dropTable tableName="provento"/>
        </rollback>
    </changeSet>

    <changeSet id="005-create-provento-mysql" author="gestao-acoes" context="mysql">
        <createTable tableName="provento">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="usuario_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="acao_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="tipo" type="VARCHAR(15)">
                <constraints nullable="false"/>
            </column>
            <column name="valor_total" type="DECIMAL(19,4)">
                <constraints nullable="false"/>
            </column>
            <column name="data_pagamento" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="criado_em" type="TIMESTAMP(6)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <rollback>
            <dropTable tableName="provento"/>
        </rollback>
    </changeSet>

    <!-- FKs e índice: portáveis, um único changeSet para os três bancos. -->
    <changeSet id="005-provento-fks" author="gestao-acoes">
        <addForeignKeyConstraint baseTableName="provento" baseColumnNames="usuario_id"
                                  constraintName="fk_provento_usuario"
                                  referencedTableName="usuario" referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="provento" baseColumnNames="acao_id"
                                  constraintName="fk_provento_acao"
                                  referencedTableName="acao" referencedColumnNames="id"/>
        <createIndex indexName="ix_provento_usuario_acao" tableName="provento">
            <column name="usuario_id"/>
            <column name="acao_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>