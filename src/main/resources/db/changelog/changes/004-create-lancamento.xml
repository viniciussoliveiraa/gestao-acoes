<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="004-create-lancamento-postgres" author="gestao-acoes" context="postgres-h2">
        <createTable tableName="lancamento">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="usuario_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="acao_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="corretora_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="tipo" type="VARCHAR(10)" defaultValue="COMPRA">
                <constraints nullable="false"/>
            </column>
            <column name="quantidade" type="NUMERIC(19,8)">
                <constraints nullable="false"/>
            </column>
            <column name="preco_unitario" type="NUMERIC(19,4)">
                <constraints nullable="false"/>
            </column>
            <column name="data_operacao" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="criado_em" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <rollback>
            <dropTable tableName="lancamento"/>
        </rollback>
    </changeSet>

    <changeSet id="004-create-lancamento-mysql" author="gestao-acoes" context="mysql">
        <createTable tableName="lancamento">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="usuario_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="acao_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="corretora_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="tipo" type="VARCHAR(10)" defaultValue="COMPRA">
                <constraints nullable="false"/>
            </column>
            <column name="quantidade" type="DECIMAL(19,8)">
                <constraints nullable="false"/>
            </column>
            <column name="preco_unitario" type="DECIMAL(19,4)">
                <constraints nullable="false"/>
            </column>
            <column name="data_operacao" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="criado_em" type="TIMESTAMP(6)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <rollback>
            <dropTable tableName="lancamento"/>
        </rollback>
    </changeSet>

    <!-- FKs e índice: portáveis, um único changeSet para os três bancos. -->
    <changeSet id="004-lancamento-fks" author="gestao-acoes">
        <addForeignKeyConstraint baseTableName="lancamento" baseColumnNames="usuario_id"
                                  constraintName="fk_lancamento_usuario"
                                  referencedTableName="usuario" referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="lancamento" baseColumnNames="acao_id"
                                  constraintName="fk_lancamento_acao"
                                  referencedTableName="acao" referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="lancamento" baseColumnNames="corretora_id"
                                  constraintName="fk_lancamento_corretora"
                                  referencedTableName="corretora" referencedColumnNames="id"/>
        <createIndex indexName="ix_lancamento_usuario_acao" tableName="lancamento">
            <column name="usuario_id"/>
            <column name="acao_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>