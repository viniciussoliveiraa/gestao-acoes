<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="003-create-usuario-postgres" author="gestao-acoes" context="postgres-h2">
        <createTable tableName="usuario">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="nome" type="VARCHAR(150)">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_usuario_email"/>
            </column>
            <column name="senha_hash" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="criado_em" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <rollback>
            <dropTable tableName="usuario"/>
        </rollback>
    </changeSet>

    <changeSet id="003-create-usuario-mysql" author="gestao-acoes" context="mysql">
        <createTable tableName="usuario">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="nome" type="VARCHAR(150)">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_usuario_email"/>
            </column>
            <column name="senha_hash" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="criado_em" type="TIMESTAMP(6)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <rollback>
            <dropTable tableName="usuario"/>
        </rollback>
    </changeSet>
</databaseChangeLog>