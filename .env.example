# Banco de dados (perfil dev/default = PostgreSQL; use SPRING_PROFILES_ACTIVE=mysql
# com jdbc:mysql://localhost:3306/gestao_acoes para rodar contra MySQL em vez de PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/gestao_acoes
SPRING_DATASOURCE_USERNAME=gestao_acoes
SPRING_DATASOURCE_PASSWORD=changeme
SPRING_PROFILES_ACTIVE=dev

# Variaveis usadas apenas pelo Docker Compose (ver compose.yaml). POSTGRES_DB reaproveita
# SPRING_DATASOURCE_USERNAME/PASSWORD acima para criar o usuario/senha do container do banco.
POSTGRES_DB=gestao_acoes
POSTGRES_PORT=5432
APP_PORT=8080

# Provedor de cotacao americano: twelve-data ou alpha-vantage
APP_MARKET_DATA_US_PROVIDER=twelve-data

# Autenticacao (JWT) - troque JWT_SECRET por um valor aleatorio forte (32+ caracteres) em qualquer
# ambiente real; o valor padrao do application.yml e apenas para desenvolvimento local
JWT_SECRET=troque-por-um-segredo-aleatorio-de-pelo-menos-32-caracteres
APP_JWT_EXPIRATION_MINUTES=120

# Origem permitida para o frontend (CORS). No Docker Compose, front e back
# ficam atras da mesma porta publicada (Nginx com proxy reverso, ver compose.yaml).
APP_CORS_ALLOWED_ORIGINS=http://localhost:8080

# BrasilAPI (dados cadastrais de CNPJ e validacao CVM) - sem autenticacao
BRASIL_API_BASE_URL=https://brasilapi.com.br/api

# ViaCEP - sem autenticacao
VIACEP_BASE_URL=https://viacep.com.br/ws

# brapi.dev (cotacoes BR)
BRAPI_BASE_URL=https://brapi.dev
BRAPI_TOKEN=

# Twelve Data (cotacoes US - provedor padrao)
TWELVE_DATA_BASE_URL=https://api.twelvedata.com
TWELVE_DATA_API_KEY=

# Alpha Vantage (cotacoes US - alternativa configuravel)
ALPHA_VANTAGE_BASE_URL=https://www.alphavantage.co
ALPHA_VANTAGE_API_KEY=