{
  "info": {
    "name": "Sistema de Gestão de Ações",
    "description": "Coleção de exemplos para a API de gestão de corretoras e ações.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Autenticação",
      "item": [
        {
          "name": "Registrar usuário",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Ana Investidora\",\n  \"email\": \"ana@exemplo.com\",\n  \"senha\": \"senhaSegura123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/registrar", "host": ["{{baseUrl}}"], "path": ["auth", "registrar"] }
          }
        },
        {
          "name": "Login (captura o token automaticamente)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    pm.collectionVariables.set('token', body.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ana@exemplo.com\",\n  \"senha\": \"senhaSegura123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login (credenciais inválidas -> 401)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ana@exemplo.com\",\n  \"senha\": \"senhaErrada\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        }
      ]
    },
    {
      "name": "Corretoras",
      "item": [
        {
          "name": "Cadastrar corretora (sucesso)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cnpj\": \"11.222.333/0001-81\",\n  \"cep\": \"01310-100\",\n  \"numero\": \"1000\",\n  \"complemento\": \"Sala 1\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/corretoras", "host": ["{{baseUrl}}"], "path": ["corretoras"] }
          }
        },
        {
          "name": "Cadastrar corretora (CNPJ inválido -> 400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cnpj\": \"11.222.333/0001-80\",\n  \"cep\": \"01310-100\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/corretoras", "host": ["{{baseUrl}}"], "path": ["corretoras"] }
          }
        },
        {
          "name": "Listar corretoras (paginado)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/corretoras?page=0&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["corretoras"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Buscar corretora por ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/corretoras/1", "host": ["{{baseUrl}}"], "path": ["corretoras", "1"] }
          }
        },
        {
          "name": "Buscar corretora por CNPJ",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/corretoras/cnpj/11222333000181",
              "host": ["{{baseUrl}}"],
              "path": ["corretoras", "cnpj", "11222333000181"]
            }
          }
        }
      ]
    },
    {
      "name": "Ações",
      "item": [
        {
          "name": "Cadastrar ação brasileira (sucesso)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ticker\": \"PETR4\",\n  \"mercado\": \"BRASIL\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/acoes", "host": ["{{baseUrl}}"], "path": ["acoes"] }
          }
        },
        {
          "name": "Cadastrar ação americana (sucesso)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ticker\": \"AAPL\",\n  \"mercado\": \"ESTADOS_UNIDOS\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/acoes", "host": ["{{baseUrl}}"], "path": ["acoes"] }
          }
        },
        {
          "name": "Cadastrar ação (ticker inexistente -> 404)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ticker\": \"ZZZZ9\",\n  \"mercado\": \"BRASIL\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/acoes", "host": ["{{baseUrl}}"], "path": ["acoes"] }
          }
        },
        {
          "name": "Listar ações (paginado)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/acoes?page=0&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["acoes"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Buscar ação por ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/acoes/1", "host": ["{{baseUrl}}"], "path": ["acoes", "1"] }
          }
        },
        {
          "name": "Buscar ação por ticker",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/acoes/ticker/PETR4",
              "host": ["{{baseUrl}}"],
              "path": ["acoes", "ticker", "PETR4"]
            }
          }
        },
        {
          "name": "Atualizar cotação de uma ação",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{baseUrl}}/acoes/1/atualizar-cotacao",
              "host": ["{{baseUrl}}"],
              "path": ["acoes", "1", "atualizar-cotacao"]
            }
          }
        }
      ]
    },
    {
      "name": "Carteira",
      "item": [
        {
          "name": "Registrar lançamento (compra)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"acaoId\": 1,\n  \"corretoraId\": 1,\n  \"quantidade\": 100,\n  \"precoUnitario\": 32.50,\n  \"dataOperacao\": \"2026-08-10\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/carteira/lancamentos", "host": ["{{baseUrl}}"], "path": ["carteira", "lancamentos"] }
          }
        },
        {
          "name": "Registrar lançamento sem token (-> 401)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"acaoId\": 1,\n  \"corretoraId\": 1,\n  \"quantidade\": 100,\n  \"precoUnitario\": 32.50,\n  \"dataOperacao\": \"2026-08-10\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/carteira/lancamentos", "host": ["{{baseUrl}}"], "path": ["carteira", "lancamentos"] }
          }
        },
        {
          "name": "Listar lançamentos (paginado)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/carteira/lancamentos?page=0&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["carteira", "lancamentos"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Listar posições consolidadas",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/carteira/posicoes", "host": ["{{baseUrl}}"], "path": ["carteira", "posicoes"] }
          }
        }
      ]
    },
    {
      "name": "Proventos",
      "item": [
        {
          "name": "Registrar provento",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"acaoId\": 1,\n  \"tipo\": \"DIVIDENDO\",\n  \"valorTotal\": 45.90,\n  \"dataPagamento\": \"2026-07-15\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/proventos", "host": ["{{baseUrl}}"], "path": ["proventos"] }
          }
        },
        {
          "name": "Listar proventos (paginado)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/proventos?page=0&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["proventos"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" }
              ]
            }
          }
        }
      ]
    }
  ]
}